[Unit]
Description=Tokina Discord DM Support bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/bot-dm-support
EnvironmentFile=/etc/bot-dm-support.env
ExecStart=/usr/bin/node /opt/bot-dm-support/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

